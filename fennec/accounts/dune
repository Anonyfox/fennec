; The accounts subsystem: users, sessions, passwords/MFA/passkeys, OAuth/OIDC/SAML/SCIM,
; orgs + RBAC. Persistence rides the fennec-mongo backends (minimongo / Burrow / mongod);
; the HTTP surface (DDP methods, OAuth/SAML endpoints, session cookies) is built on fennec-paw.
; The native I/O shell, middleware battery, websockets, TLS/ACME and host routing now live in
; the standalone fennec-paw library.

(library
 (name fennec_accounts)
 (public_name fennec.accounts)
 ; fennec-paw: the HTTP toolkit accounts builds its endpoints + session middleware on.
 ; x509 + the crypto stack (mirage-crypto via x509, zarith, digestif, base64): token/cert
 ; handling for passkeys / OIDC / SAML. zlib + bigstringaf: SAML deflate. fennec.mail +
 ; fennec.fur: the templated verification / reset emails.
 (libraries
  fennec.accounts.primitives
  fennec-paw
  fennec-mongo.bson
  fennec-mongo.bson_json
  fennec-mongo.minimongo
  fennec-mongo.driver
  fennec-mongo.backend
  fennec-mongo.dynamic
  fennec-mongo.json
  fennec.mail
  fennec.fur
  unix
  digestif
  base64
  zlib
  bigstringaf
  x509
  zarith
  ptime
  mirage-crypto-rng.unix
  fennec-hunt.unit
  fennec-hunt.prop)
 (inline_tests
  (backend fennec-hunt.runner))
 (preprocess
  (pps fennec-hunt.ppx)))
