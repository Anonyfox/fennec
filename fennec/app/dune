; The userland facade — `Fennec`. The one server-side library an app's server.ml
; depends on: owns Eio, the dev/prod web-root flip, dev livereload, and serve.
; Paw is the HTTP foundation we build on, so we (re_export) it: a downstream app
; depends on `fennec` alone and names `Paw.*` directly (open Paw) — no proxy module,
; no second dune dep. Conn/Endpoint/Http/Cookie/middleware all come straight from Paw.

(library
 (name fennec)
 (public_name fennec)
 (modes byte native)
 (libraries
  (re_export fennec-paw)
  fennec.accounts
  fennec.fur
  fennec.fur.server
  fennec.mail
  fennec.web
  fennec.pulse.sift
  fennec-mongo.driver
  fennec-mongo.dynamic
  eio
  eio_main))
