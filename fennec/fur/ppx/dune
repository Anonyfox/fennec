; The mlx -> Fur ppx: JSX -> Fur_html/Fur.comp, <script setup>, event/each/key sugar,
; auto-node for `(expr)` value children, frag-inference for list children, and the `!s`
; signal-read sugar (.mlx-only; on plain .ml `!` stays OCaml deref).
; Also registers the inline test rules (let%test / let%test_unit) from fennec-hunt.ppx.rules,
; so a library using (pps fennec.fur.ppx) gets BOTH MLX sugar AND inline tests in ONE ppx
; process — no need to also list fennec-hunt.ppx.

(library
 (name fennec_fur_ppx)
 (public_name fennec.fur.ppx)
 (kind ppx_rewriter)
 (libraries ppxlib fennec-hunt.ppx.rules fennec.pulse.sift.ppx.rules)
 (preprocess
  (pps ppxlib.metaquot))
 (flags
  (:standard)))
