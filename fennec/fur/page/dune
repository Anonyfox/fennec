; The standalone PAGE — a Fur concept (presentation: view + SSR + the cross-stage seed), NOT a
; separate "web" module. ISOMORPHIC (Fur + Codec + Bson_json, all jsoo-safe), so a page's view links
; into both the server SSR and the page's OWN jsoo bundle. The one Conn-aware bit (serve : Conn ->
; Conn) is added by the app facade; the client boot is Fur_csr.start_page.

(library
 (name fennec_fur_page)
 (public_name fennec.fur.page)
 (wrapped false)
 (modes byte native)
 (libraries fennec.fur fennec.pulse.codec fennec-mongo.bson_json)
 (inline_tests
  (backend fennec-hunt.runner))
 (preprocess
  (pps fennec-hunt.ppx)))
