; Differential correctness: run the SAME operations through the in-memory backend (Backend.Mini) and
; the native libmongoc backend against a REAL mongod, and assert identical results — the proof that
; Minimongo is a faithful swap for real mongo across query/update operators. Skips (passes) when the
; native driver wasn't built or no mongod is installed.

(tests
 (names test_diff test_observe test_dynamic test_embedded test_burrow_vs_mongod test_gridfs_mongod
   test_wire_server test_wire_mongosh test_wire_tls)
 (libraries
  fennec-mongo.dynamic
  fennec-mongo.backend
  fennec.pulse
  fennec-mongo.mongod
  fennec-mongo.driver
  fennec-mongo.bson
  fennec-mongo.query
  fennec-mongo.minimongo
  fennec-mongo.burrow
  fennec-mongo.burrow.store
  fennec-mongo.gridfs
  tls
  x509
  ptime
  mirage-crypto-rng.unix
  eio
  eio.unix
  eio_main
  unix
  fennec-hunt.unit)
 (preprocess
  (pps fennec-hunt.ppx)))
