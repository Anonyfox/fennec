; JS-BOUNDARY GATE — see check_js_boundary.sh. js_gate links the browser-shipped stack — the reactive
; layer (fennec.pulse) over the in-memory backend AND the Meteor-shaped accounts client (which transitively
; pulls in Fur + the DDP client) — and the rule asserts its bytecode closure contains NO native unit. A
; native dep leaking into ANY of them fails the build (caught by `dune runtest` / `fennec test`). This is
; the insurance that the whole client bundle stays JS-compilable.
(executable
 (name js_gate)
 (modes byte)
 (libraries fennec.pulse fennec-mongo.backend fennec-mongo.minimongo fennec.accounts.client))

(rule
 (alias runtest)
 (deps js_gate.bc check_js_boundary.sh)
 (action
  (run sh check_js_boundary.sh js_gate.bc)))
