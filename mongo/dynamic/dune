 (name fennec_mongo_dynamic)
 (public_name fennec-mongo.dynamic)
 (libraries
  fennec-mongo.backend
  fennec-mongo.bson
  fennec-mongo.query
  fennec-mongo.driver
  fennec-mongo.ffi
  fennec-mongo.burrow
  fennec-mongo.wire
  base64
