; The site example — ONE shared public/ + a single isomorphic frontend/ tree (apps,
; components, documents), on Fennec.Fur: signals + SSR + js_of_ocaml hydration. No
; Melange, no React, no preact runtime, no require-shim — the client bundle is a
; self-contained jsoo build, so there is no shared /react.js and no native/CSR mirror.
;
; Per CLI-INTEROP.md the web root is assembled from STABLE per-bundle file targets
; (each its own `fennec build` rule), then one (dir webroot) rule --includes them at
; their served paths + --publics public/. Stable targets (not a single dir assembler)
; so dev livereload hot-swaps a CSS edit and reloads only on a JS edit. Each app is a
; few rules here; pages/components inside an app need no dune change.

; The per-app client bundle IS the js_of_ocaml output (_client/<app>.bc.js, built from
; a route_gen-generated boot): a self-contained browser script, no further bundling
; needed (esbuild can't bundle the jsoo runtime's node-guarded requires, and there are
; no npm deps to resolve). It is --included into the web root below, at its served path.

; `_client/` holds the generated client-bundle plumbing. dune ignores `_`-prefixed directories by
; default (the same rule that hides `_build`), so we re-include it here: the leading underscore still
; tells a human "generated, don't touch" (see _client/README.md), while dune still builds it.
(dirs :standard _client)

; ---- assemble the SERVED web root: just merge the staged trees. Apps and handlers each generate
; their own isolated bundles (+ app css) into served/_apps|_handlers/<name>/main.{js,css} via
; route_gen + dynamic_include (_client/apps, _client/handlers); here we only --public them next to the
; shared public/ tree. Adding an app OR a handler needs NO change in this file. ----

(rule
 (targets
  (dir webroot))
 (deps
  (source_tree public)
  (glob_files_rec _client/apps/run/served/*)
  (glob_files_rec _client/handlers/run/served/*))
 (action
  (run
   %{bin:fennec}
   build
   -o
   webroot
   --public
   public
   --public
   _client/apps/run/served
   --public
   _client/handlers/run/served)))

; ---- prod embed module (release bakes the web root in; dev = empty stub) ----

(rule
 (target assets.ml)
 (enabled_if
  (= %{profile} release))
 (deps webroot)
 (action
  (run %{bin:fennec} build -o webroot --embed assets.ml)))

(rule
 (target assets.ml)
 (enabled_if
  (<> %{profile} release))
 (action
  (with-stdout-to
   assets.ml
   (echo "let lookup (_ : string) : string option = None\n"))))

(alias
 (name all)
 (deps webroot))

(alias
 (name default)
 (deps webroot))

; the dev loop target: bytecode server + assembled web root, rebuilt on edit.
;   fennec dev --target @examples/site/dev _build/default/examples/site/server.bc

(alias
 (name dev)
 (deps server.bc webroot))

(executable
 ; dev builds the bytecode server (server.bc); release builds native server.exe.
 (name server)
 (modes byte exe)
 (modules server assets)
 (preprocess
  (pps fennec.fur.ppx))
 (libraries
  fennec
  fennec.fur
  fennec.fur.server
  fennec.pulse.sift
  web_app
  site_handlers
  admin_app
  site_components
  site_styles
  site_store
  fennec.pwa
  fennec.pulse.app))

; the CONSOLE target (`fennec console`) — a bytecode toplevel that boots the SAME runtime as the server
; (no HTTP) and drops into a REPL with the whole app + framework in scope. It links the dev-only
; `fennec.console.engine` (which links the compiler) and uses -linkall so the toplevel can resolve EVERY
; linked module against its live runtime symbols. It calls `Fennec.console_run`, never `Fennec.serve`, so
; the CLI's server discovery ignores it — adding it leaves `server.bc`/`server.exe` untouched. Bytecode
; only (the toplevel is bytecode); it never reaches a release build.
(executable
 (name console)
 (modes byte)
 (modules console)
 (link_flags (-linkall))
 (libraries
  fennec
  fennec.console.engine
  fennec.fur
  fennec.fur.server
  fennec.pulse.sift
  web_app
  site_handlers
  admin_app
  site_components
  site_styles
  site_store
  fennec.pwa
  fennec.pulse.app))

; The prod-lean guarantee (the server.exe must not link the e2e/CDP test machinery) is enforced by a
; `dune runtest` guard in test/lean/ — kept beside the other tests, not loose in the app root.
