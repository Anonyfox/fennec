; Inlined component styles. style_extract scans the components' [%%style] blocks and emits ONE module:
;   Site_styles.css    — every block scoped to the data-fur hash the ppx stamps; the server inlines it
;                         into the document <style> for the web.
;   Site_styles.inline — the same rules flattened for the email inliner, with var(--brand) resolved to a
;                         literal against the app's brand (--tokens, below). The app installs it once with
;                         Fur_email.install; thereafter Fur_email.to_email needs nothing per render.
; Pure data (no deps). Regenerates when a component's styles or the brand :root change.

(library
 (name site_styles)
 (modules site_styles))

(rule
 (target site_styles.ml)
 (deps
  (glob_files_rec %{project_root}/examples/site/frontend/components/*.mlx)
  %{project_root}/examples/site/frontend/apps/web/main.scss
  %{project_root}/fennec/fur/tools/style_extract.exe)
 (action
  (run
   %{project_root}/fennec/fur/tools/style_extract.exe
   site_styles.ml
   --tokens
   %{project_root}/examples/site/frontend/apps/web/main.scss
   %{project_root}/examples/site/frontend/components)))
