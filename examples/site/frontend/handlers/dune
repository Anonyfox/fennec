; Standalone HANDLERS — one .mlx = one handler = one bundle, all under frontend/ as first-class
; citizens (no parallel folders). The fur ppx (-handler) fuses each file's payload/load/view into a
; server `serve` (this lib, e.g. Site_handlers.Greet.serve) and a client `boot` (the mirror below).
; You mount each serve MANUALLY in server.ml at any path you like (params, reuse across paths) —
; central-router DX. Adding a handler = drop a .mlx here; route_gen regenerates its bundle.
(library
 (name site_handlers)
 (modules :standard)
 (libraries fennec fennec.fur fennec.fur.html fennec.fur.handler fennec.pulse.codec site_components)
 (preprocess
  (pps fennec.fur.ppx -handler))
 (flags
  (:standard -w -a -open Fur)))

; the CLIENT half — the SAME .mlx, compiled with -conn-client so `load` is stripped (the jsoo bundle
; never sees Conn). copy_files keeps it inside this one folder (no parallel pages_client next to
; frontend); the generated bundles (client/handlers) link this lib.
(subdir
 client
 (copy_files#
  (files ../*.mlx))
 (library
  (name site_handlers_client)
  (modules :standard)
  (libraries fennec.fur fennec.fur.html fennec.fur.handler fennec.fur.client fennec.pulse.codec site_components)
  (preprocess
   (pps fennec.fur.ppx -handler -conn-client))
  (flags
   (:standard -w -a -open Fur))))
