(* The "anonymous, cacheable frame → personalization snaps in" contract, in one component.

   On the SERVER (SSR) the page is rendered user-blind: the always-on [__currentUser] live
   publication is userId-scoped, but the native SSR Ddp_client registers no fetcher for it, so the
   subscription resolves empty and [Fennec_accounts_client.current_user ()] stays [None]. The
   server-rendered HTML is therefore identical for every visitor (and logged-out) → uniformly
   edge/CDN-cacheable, and structurally cannot leak one user's data into a shared cached frame.

   In the BROWSER the WebSocket upgrade carries the (HttpOnly) login cookie, the server seeds the
   session userId, the [__currentUser] subscription re-scopes to the real user, the merge store fills
   in, and this [user] signal recomputes — so "Hello, …" SNAPS IN over the "Sign in" frame.

   The slot below is a FIXED height/width, so that None→Some transition is a clean swap with no
   layout shift — the snap is a fill-in, not a reflow. See fennec/accounts/README.md, the section
   "SSR + the reactive user (the anonymous, cacheable frame)".

   NOTE — to see the snap live end-to-end you turn auth on once, in server.ml:
     let () = Fennec.serve ~accounts:Fennec.Accounts.defaults ~on_start [ web; admin ]
   with MONGO_URL set (`:memory:` in dev), then sign a user in (a tiny [login_with_password] form,
   or the built-in /auth routes). With auth off the component still renders correctly — it just
   stays on the anonymous frame, because [current_user ()] is always [None]. *)

module Accounts = Fennec_accounts_client

[%%style {scss|
.user-badge { display: inline-flex; align-items: center; justify-content: center; height: 2rem; min-width: 9rem; padding: 0 .8rem; border: 1px solid #e3e3e3; border-radius: 999px; font: inherit; box-sizing: border-box }
.ub-anon { color: #555 }
.ub-signin { margin-left: .4rem; color: var(--brand); text-decoration: none; font-weight: 600 }
.ub-signin:hover { text-decoration: underline }
.ub-hello { color: var(--brand); font-weight: 600 }
|scss}]

(* the one page connection (ambient, same socket Task_list rides). The default Accounts client
   ([current_user ()]) wraps this very DDP connection, so when a session exists in the browser the
   live [__currentUser] sub feeds the [user] signal below. *)
let () = Pulse.connect ~path:"/ddp" ()

let make () =
  (* [current_user ()] : user option Fur.signal — Meteor's Meteor.user(), live over the user
     document. [None] during SSR (the cacheable frame) and until hydration re-scopes the sub. *)
  let user = Accounts.current_user () in
  let name (u : Accounts.user) = Option.value u.username ~default:"there" in
  fun () ->
    (* ONE fixed-size slot — identical box whether anonymous or personalized, so the snap-in is a
       fill, never a layout shift. *)
    <span className="user-badge">
      (match !user with
       | None ->
         <span className="ub-anon">
           "Guest"<a className="ub-signin" href="/login">"Sign in"</a>
         </span>
       | Some u -> <span className="ub-hello">("Hello, " ^ name u)</span>)
    </span>
