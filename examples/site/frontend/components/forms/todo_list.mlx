(* FORMS + GLOBAL STATE + keyed lists. The draft is now a TYPED CLIENT FORM (`Form.signal` over
   Todo_form.codec) instead of a raw `signal ""` + a hand-written `<> ""` check: the [@trim][@non_empty]
   [@max_len 80] refinements validate the draft reactively, offline, the same way the server would — Add
   stays disabled until the draft is valid, the field error shows inline, and the <input>'s [maxlength]
   comes off the codec (`Form.input_attrs`). On submit `Form.submit` yields the typed Todo_form.t. The
   `each` over the reactive Store.todos still keys rows so the reconciler moves instead of rebuilding;
   mutating the global Store updates <Stats/> elsewhere too. *)
[%%style {scss|
.todos { margin: 1rem 0 }
.todo-input { font: inherit; padding: .3rem .5rem; border: 1px solid #ccc; border-radius: 6px }
.todo-input.invalid { border-color: #c0392b }
.todo-add { font: inherit; margin-left: .4rem; cursor: pointer }
.todo-add:disabled { opacity: .5; cursor: not-allowed }
.todo-err { color: #c0392b; font-size: .82em; margin: .3rem 0 0 }
.todo-items { list-style: none; padding: 0; margin: .6rem 0 0 }
.todo { display: flex; gap: .5rem; align-items: center; padding: .15rem 0 }
.rm { cursor: pointer; border: none; background: none; color: #c00; font-size: 1.1em }
|scss}]

(* the typed draft: one signal of Todo_form.t + a memoized Sift.validate error list (replaces `signal ""`) *)
let draft = Form.signal Todo_form.codec Todo_form.empty
let add () =
  match Form.submit draft with
  | Ok (t : Todo_form.t) -> Store.add t.text; Form.set draft Todo_form.empty  (* typed, validated text *)
  | Error _ -> ()                                                              (* invalid — keep the draft *)
let view =
  <div className="todos">
    <input id="todo-input"
           attrs=(Form.input_attrs Todo_form.Fields.text)   (* maxlength=80 straight off the codec *)
           className=(if Form.field_error draft Todo_form.Fields.text <> None then "todo-input invalid" else "todo-input")
           placeholder="new todo"
           value=((Form.value draft).text)
           onInput=(Form.update draft (fun d -> { d with text = target_value () }))
           onKeydown=(if key () = "Enter" then add ()) />
    <button id="add" className="todo-add" disabled=(not (Form.valid draft)) onClick=(add ())>add</button>
    {match Form.field_error draft Todo_form.Fields.text with
     | Some msg -> <p className="todo-err">{msg}</p>
     | None -> <span />}
    <ul className="todo-items">
      {each !Store.todos (fun (t : Store.todo) ->
         <li key=t.id className="todo">
           {t.text}
           <button className="rm" onClick=(Store.remove t.id)>×</button>
         </li>)}
    </ul>
  </div>

let%test "todo_list: input + add button, codec-driven maxlength=80, add disabled while the draft is invalid" =
  let html = Fur.to_html (make () ()) in
  let has = Fennec_hunt_unit.str_contains html in
  has {|id="todo-input"|} && has {|id="add"|} && has {|maxlength="80"|} && has "disabled"
