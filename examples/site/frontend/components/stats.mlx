(* Reads the SAME global Store as Todo_list — adding/removing a todo there updates this
   count reactively, demonstrating shared state across independent components. *)
[%%style {scss|
.stats { margin: .6rem 0; color: #555; font-size: .9em }
|scss}]

let view = <div className="stats">todos in store: {List.length !Store.todos}</div>

let%test "stats: reads the (empty) global store — 0 todos" =
  let html = Fur.to_html (make () ()) in
  Fennec_hunt_unit.str_contains html "todos in store: 0"
