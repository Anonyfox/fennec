(* The /greet page VIEW — isomorphic. Decodes the server-seeded payload (the cross-stage value) with
   the SAME codec the server encoded with, so it SSRs and then hydrates byte-for-byte. It shows the
   TWO halves of the model together:
     - SEED the static: the greeting + the count are cross-stage values, in the page pre-JS, and the
       count flows into the live <Counter/>'s starting state (seed -> interactive state).
     - RECONSTRUCT the live: <Task_list/> holds no seeded rows — after hydration it opens its own DDP
       subscription and fills in live (Meteor-style), and addTask pushes new rows back. Behaviour and
       live data cross as Pulse HANDLES, never serialized.
   Named [page] (not [view]) so the Fur ppx leaves it a plain unit -> vnode composer. *)
let page () =
  let g = Data.value (Page.resource Greet.codec ~key:"page:greet" ~fallback:Greet.empty) in
  <main className="greet" id="greet">
    <h1>(node ("Hello, " ^ g.Greet.who ^ "!"))</h1>
    <p className="seed">(node ("server-computed start = " ^ string_of_int g.Greet.count))</p>
    (* seeded value -> interactive state: the live counter STARTS at the server-computed count *)
    <Counter label="clicks" start=(g.Greet.count) />
    (* live data RECONSTRUCTED, not seeded: subscribes after hydration and fills in over DDP *)
    <Task_list />
  </main>
