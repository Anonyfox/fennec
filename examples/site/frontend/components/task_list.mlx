(* Realtime task list — the whole DDP loop in one component. On the SERVER it renders an empty list
   (the native Ddp_client stub: no socket); in the BROWSER `connect` opens a real WebSocket to /ddp,
   `on_mount` subscribes, and `find` is a Fur signal that recomputes as the server pushes deltas — so
   the list fills in after hydration and grows live. Clicking "Add task" calls the addTask method;
   the server inserts and the new doc returns through the open subscription (no refetch). Proof of
   the server→client push, end to end, in the browser. *)
[%%style {scss|
.tasks { margin: 1rem 0; padding: .7rem 1rem; border: 1px solid #e3e3e3; border-radius: 8px }
.tasks h2 { margin: 0 0 .5rem; font-size: 1.05rem }
.task-items { margin: 0 0 .6rem; padding-left: 1.2rem }
.task-items li { margin: .15rem 0 }
.add-task { cursor: pointer; border: 1px solid var(--brand); background: var(--brand); color: #fff; border-radius: 6px; padding: .25rem .8rem; font: inherit }
.add-task:hover { opacity: .9 }
|scss}]

open Task   (* the model: brings its fields into scope (queries read bare) AND its Tasks view *)

let () = Pulse.connect ~path:"/ddp" ()   (* the one page connection (ambient) *)
(* a plain non-reactive counter for naming added tasks. It stays a genuine OCaml [ref]; it is read
   with [added.contents], NOT [!added], because in a [.mlx] file [!s] is the signal-read sugar
   ([get s]) — so a real ref deref spells out [.contents] to stay clear of it. (The type checker
   also keeps them apart: a signal is not a ref.) *)
let added = ref 0

(* SETUP (runs once when this <Task_list/> mounts): open the subscription, bind the live [find]
   signal, define the click handler. The trailing <div> is the RENDER (the ppx wraps it as the
   render thunk) — it re-runs as the server pushes deltas, because it reads the live [!ready] /
   [!tasks] signals in the markup. *)
let make () =
  (* subscribe for this component's lifetime (auto-stops on cleanup) — Meteor's Meteor.subscribe *)
  let ready = Pulse.subscribe ~name:"tasks" () in
  (* the collection IS the object — no client, no handle. PROJECTED live read ships/types ONLY title
     (Meteor's { fields: { title: 1 } }); [t#title] works, [t#body] is a compile error. *)
  let tasks = project [%fields title] ~where:[%q title <> ""] ~sort:[%sort title asc] () in
  let add_task () =
    incr added;
    (* the TYPED method call — a wrong argument type is a compile error (Meteor's Meteor.call) *)
    ignore (Pulse.call Site_methods.add_task ("Task " ^ string_of_int added.contents))
  in
  <div className="tasks">
    <h2>"Live tasks"</h2>
    (if !ready then
       <ul className="task-items">
         (each (Array.to_list !tasks) (fun t -> <li>(t#title)</li>))
       </ul>
     else <p className="loading">"Loading tasks…"</p>)
    <button className="add-task" onClick=(add_task ())>"Add task"</button>
  </div>
