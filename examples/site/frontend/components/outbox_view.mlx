(* The dev mailbox — a standalone realtime inbox over the "_fennec_outbox" collection. The WHOLE thing is
   the same DDP loop as Task_list: on the SERVER it renders the empty shell (the native Ddp_client stub has
   no socket); in the BROWSER `connect` opens the WebSocket to /ddp, `subscribe` streams the captured mail,
   and `find` is a Fur signal that recomputes as the server pushes — so a freshly-sent email appears at the
   top live, no refresh. The HTML body renders in a sandboxed <iframe srcdoc> (its own styles, scripts off).
   This component IS the userland template: copy it, restyle it, it's yours — the framework only ships the
   building blocks it leans on (the [@@deriving collection] model, the reactive client, Fur). *)
[%%style {scss|
.devmail { font: 14px/1.5 system-ui, sans-serif; color: #1c2024; max-width: 1000px; margin: 1.5rem auto; border: 1px solid #e3e3e3; border-radius: 10px; overflow: hidden }
.devmail-bar { display: flex; align-items: baseline; gap: .8rem; padding: .7rem 1rem; background: #fafafa; border-bottom: 1px solid #e3e3e3 }
.devmail-logo { font-weight: 600 }
.devmail-count { color: #8a9099; font-size: .85rem }
.devmail-status { padding: 2rem 1rem; color: #8a9099; text-align: center }
.devmail-grid { display: grid; grid-template-columns: 300px 1fr; min-height: 420px }
.devmail-list { list-style: none; margin: 0; padding: 0; border-right: 1px solid #e3e3e3; overflow-y: auto; max-height: 540px }
.mrow { padding: .6rem .9rem; border-bottom: 1px solid #f0f0f0; cursor: pointer }
.mrow:hover { background: #f7f9fb }
.mrow-on { background: #eef4ff }
.mrow-on:hover { background: #eef4ff }
.mrow-subj { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
.mrow-meta { color: #8a9099; font-size: .8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
.devmail-view { padding: 1rem 1.2rem; overflow: auto }
.devmail-hint { color: #8a9099 }
.msg-head { border-collapse: collapse; margin-bottom: .8rem; font-size: .9rem }
.msg-head th { text-align: right; color: #8a9099; font-weight: 500; padding: .1rem .6rem .1rem 0; vertical-align: top; white-space: nowrap }
.msg-head td { padding: .1rem 0 }
.msg-html { width: 100%; height: 420px; border: 1px solid #e3e3e3; border-radius: 6px; background: #fff }
.msg-text { white-space: pre-wrap; background: #fafafa; border: 1px solid #e3e3e3; border-radius: 6px; padding: .8rem; margin: 0 }
|scss}]

open Outbox   (* the model: brings its record fields into scope AND the generated Outbox collection reads *)

let () = Pulse.connect ~path:"/ddp" ()   (* the one page connection (ambient), exactly as Task_list *)

let make () =
  (* subscribe for this component's lifetime; [find] returns full records (Outbox.t), newest first *)
  let ready = Pulse.subscribe ~name:"_fennec_outbox" () in
  (* newest first, and bound the rendered list — the outbox is in-memory (cleared on restart), so this is
     a render guard, not storage management *)
  let mails = find ~sort:[%sort received desc] ~limit:200 () in
  let selected = signal "" in   (* the open message's id ("" = none) — SETUP-local state *)
  let subj m = if m.subject = "" then "(no subject)" else m.subject in
  (* the trailing <div> is the RENDER thunk (ppx-wrapped): re-runs as the subscription pushes
     and on every [set selected …]; the live [!mails] / [!selected] reads are in the markup. *)
  <div className="devmail">
    <header className="devmail-bar">
      <span className="devmail-logo">"✉  Dev mailbox"</span>
      <span className="devmail-count">{string_of_int (Array.length !mails) ^ " captured"}</span>
    </header>
    (if not !ready then <p className="devmail-status">Connecting to /ddp…</p>
     else if Array.length !mails = 0 then
       <p className="devmail-status">
         No mail captured yet. Trigger a send — sign-up, password reset, … — and it shows up here live.
       </p>
     else
       <div className="devmail-grid">
         <ul className="devmail-list">
           (each (Array.to_list !mails) (fun m ->
              <li className=(if !selected = m.id then "mrow mrow-on" else "mrow")
                  onClick=(set selected m.id)>
                <div className="mrow-subj">{subj m}</div>
                <div className="mrow-meta">{m.recipients ^ "  ·  " ^ m.received}</div>
              </li>))
         </ul>
         <section className="devmail-view">
           (match Array.find_opt (fun m -> m.id = !selected) !mails with
            | None -> <p className="devmail-hint">Select a message to read it.</p>
            | Some m ->
              <article>
                <table className="msg-head"><tbody>
                  <tr><th>From</th><td>{m.sender}</td></tr>
                  <tr><th>To</th><td>{m.recipients}</td></tr>
                  <tr><th>Subject</th><td>{subj m}</td></tr>
                  <tr><th>Date</th><td>{m.received}</td></tr>
                </tbody></table>
                (* the typed <iframe> has no srcdoc/sandbox — drop to the raw [h]/[attr] builder. sandbox=""
                   is the maximally-restricted iframe (scripts + same-origin off): the email's own HTML/CSS
                   renders isolated, can't script the dev page. *)
                (if m.html <> "" then
                   h "iframe"
                     [ attr "class" "msg-html"; attr "sandbox" ""; attr "srcdoc" m.html;
                       attr "title" "message html body" ]
                     []
                 else <pre className="msg-text">{m.text}</pre>)
              </article>)
         </section>
       </div>)
  </div>
