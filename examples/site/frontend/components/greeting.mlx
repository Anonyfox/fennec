(* CO-LOCATED ISOMORPHIC DATA — the component declares its OWN server fetcher, inline. [Data.local]
   takes a [Server_only.fn] thunk: on the SERVER the framework registers it as BOTH the SSR seed source
   (run between render passes → embedded as a fast-render seed) AND the auto-mounted HTTP refetch route
   (/api/greeting, derived from the name) — so server.ml needs no api_source arm and no Paw.get. The
   client reads the seed on boot (no loading flash); [refetch] then hits that same auto-mounted route.

   The fetcher is server-only TWICE over: [Server_only.fn] has no Sift (it can never be seeded — only the
   STRING it returns is), and the fur ppx STRIPS its body from the jsoo bundle (the -data-client client
   mirror), so [compute_greeting] never reaches the browser. The value lives HERE, in the component —
   not in server.ml behind a magic key. *)
[%%style {scss|
.greeting { margin: 1rem 0; padding: .6rem .9rem; border: 1px solid #eee; border-radius: 6px }
.msg { margin: 0; display: inline }
.gstatus { color: #888; font-size: .85em }
.grefetch { margin-left: .6rem; cursor: pointer }
|scss}]

(* the SERVER fetcher — a unique token in here proves the strip (it must be ABSENT from web.bc.js). On
   a real app this would read a DB / call a service; it is stripped from the client either way. *)
let compute_greeting () = "Hello from the server 👋 (FENNEC_COLOCATED_FETCHER)"

let g = Data.local "greeting" ~fallback:"…" (Data.Server_only.fn (fun () -> compute_greeting ()))
let view =
  <div className="greeting">
    <p className="msg">(Data.value g)</p>
    <span className="gstatus">(if Data.loading g then " (loading)" else " (ready)")</span>
    <button className="grefetch" id="refetch" onClick=(Data.refetch g)>"refetch"</button>
  </div>
