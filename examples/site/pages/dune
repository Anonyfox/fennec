; SERVER half of the standalone pages: the fur ppx EXPANDS [%%conn] into `serve` (the conn block runs
; with the full Conn + Pulse + Accounts via the facade). Native only — the client mirror is
; ../pages_client (same sources, ppx -conn-client, jsoo). A page = one .mlx here; server.ml wires
; Site_pages.<Page>.serve. Depends on the facade (fennec) for the conn block, plus the view's needs.
(library
 (name site_pages)
 (modules :standard)
 (libraries fennec fennec.fur fennec.fur.page site_store site_components)
 (preprocess
  (pps fennec.fur.ppx))
 (flags
  (:standard -w -a -open Fur)))
