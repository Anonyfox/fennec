(* The /greet PAGE — ONE file. The isomorphic essence (key/codec/bundle + the `page` view that reads
   the seed) compiles into BOTH the server SSR and the page's own jsoo bundle. The SERVER conn block
   lives in [%%conn]: the fur ppx expands it to `serve` for the server build and STRIPS it for the
   client build, so the jsoo bundle never sees Conn. One file, no router — a standalone SPA.

   Inside [%%conn] the facade is open: Conn / Render / Server_only / Accounts / Pulse are all in scope. *)
let key = "page:greet"
let codec = Greet.codec
let bundle = "/_pages/greet/main.js"

let page () =
  let g = Data.value (Page.resource codec ~key ~fallback:Greet.empty) in
  <main className="greet" id="greet">
    <h1>(node ("Hello, " ^ g.Greet.who ^ "!"))</h1>
    <p className="seed">(node ("server-computed start = " ^ string_of_int g.Greet.count))</p>
    (* seeded value -> interactive state: the live counter STARTS at the server-computed count *)
    <Counter label="clicks" start=(g.Greet.count) />
    (* live data RECONSTRUCTED, not seeded: subscribes after hydration and fills in over DDP *)
    <Task_list />
  </main>

[%%conn
fun conn ->
  (* a server-only secret: [Server_only.t] has NO codec, so it literally cannot be put in the payload
     record — a leak is a COMPILE error, not a discipline. It stays on the server (here it would
     authorize a backend call); only the shaped {who; count} payload crosses. *)
  let api_key = Server_only.wrap "sk-live-d34db33f" in
  match Conn.query conn "name" with
  | (Some "" | None) -> Render { Greet.who = "world"; count = 5 }
  | Some who ->
    ignore (Server_only.get api_key) (* used server-side only — never seeded *);
    Render { Greet.who; count = String.length who }]
