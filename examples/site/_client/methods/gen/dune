; GENERATOR: route_gen --mirror reads the EXTERNAL web/methods/ tree and emits dune.inc — one
; copy_files# per authored subdir, flattening the nested tree into the client mirror in ../run. Globbing
; the external source (never ../run) avoids the dynamic_include cycle. Add a method = it just appears.
(rule
 (deps
  (source_tree %{project_root}/examples/site/web/methods)
  %{project_root}/fennec/fur/tools/route_gen.exe)
 (target dune.inc)
 (action
  (run
   %{project_root}/fennec/fur/tools/route_gen.exe
   --mirror
   %{project_root}/examples/site/web/methods
   .
   examples/site/web/methods)))
