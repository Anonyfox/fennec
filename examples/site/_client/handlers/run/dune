; CONSUMER: evaluate the generated per-handler bundle stanzas in-pass. One .mlx = one .bc.js here,
; fully incremental (jsoo separate compilation shares artifacts). A native staging rule then lays each
; handler out as served/_handlers/<name>/main.js, which the webroot --public's; the served URL matches the
; ppx-derived bundle URL (/_handlers/<name>/main.js). The stager (fennec.fur.tools.stage) is ONE native
; exec — it replaced a per-file bash fork-loop. No hand-written stanza per handler.
(dynamic_include ../gen/dune.inc)

(rule
 (deps
  (glob_files_rec *.bc.js)
  %{project_root}/fennec/fur/tools/stage.exe)
 (targets
  (dir served))
 (action
  (run %{project_root}/fennec/fur/tools/stage.exe _handlers)))
