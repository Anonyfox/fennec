; GENERATED client mirror of site_documents — the SAME .mlx tree (flattened in from ../gen/dune.inc's
; copy_files#) compiled with -data-client. Document shells carry no Data.local, but the client libs link a
; -data-client closure end to end, so this stripped twin keeps that closure pure. The app bundles link
; site_documents_client; the server links the un-stripped site_documents. Do not edit.
(library
 (name site_documents_client)
 (wrapped false)
 (libraries fennec.fur fennec.fur.html)
 (preprocess
  (pps fennec.fur.ppx -data-client))
 (flags
  (:standard -w -a -open Fur)))

(dynamic_include ../gen/dune.inc)
