; CONSUMER: evaluate the generated per-app bundle stanzas in-pass (one isolated .bc.js + .css per
; app, incremental via jsoo separate compilation). One fixed staging rule lays them out as the served
; tree _apps/<app>/{main.js,main.css}, which the webroot --public's.
(dynamic_include ../gen/dune.inc)

(rule
 (deps
  (glob_files_rec *.bc.js)
  (glob_files_rec *.css))
 (targets
  (dir served))
 (action
  (bash
   "mkdir -p served/_apps; for f in *.bc.js; do [ -e \"$f\" ] || continue; n=$(basename \"$f\" .bc.js); mkdir -p \"served/_apps/$n\"; cp \"$f\" \"served/_apps/$n/main.js\"; done; for f in *.css; do [ -e \"$f\" ] || continue; n=$(basename \"$f\" .css); mkdir -p \"served/_apps/$n\"; cp \"$f\" \"served/_apps/$n/main.css\"; done")))
