; Global state store — shared signals (Store.todos, …). Wrapped false so a file is just its module
; (Store, …). Group into subfolders freely: (include_subdirs unqualified) folds the whole tree into this
; one lib, flat namespace, no dune in any subfolder. No client mirror — store is isomorphic (the SAME lib
; links into the server AND every jsoo bundle), so nesting it costs nothing extra.
(include_subdirs unqualified)

(library
 (name site_store)
 (wrapped false)
 (libraries fennec.fur fennec.pulse.method fennec.pulse.sift fennec.pulse.sift.mongo fennec.pulse.live fennec.pulse.live.client fennec-mongo.bson)
 (preprocess (pps fennec.fur.ppx))   ; the one driver: mlx + tests + collection deriver + DSLs
 (flags
  (:standard -w -a -open Fur)))
