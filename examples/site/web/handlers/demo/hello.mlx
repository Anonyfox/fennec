(* A server-rendered FORM handler — the middle layer between an inline Paw handler and a full SPA app,
   authored as ONE .mlx (JSX, no `h`/`text`/`attr` builders). `view : Form.ctx -> vnode` renders the
   form; `submit : conn -> t -> Form.outcome` runs the POST. The fur ppx derives get/post/serve and
   route_gen skips the bundle (server-only, no JS). Mounted in server.ml at any path with `Endpoint.form`.

   Re-rendering HTML is first-class: `submit` returns `again` (re-show the form with an error — the input
   is PRESERVED, awaiting correction) or `redirect` (post-redirect-get). Sift-invalid input (empty / too
   long) re-renders automatically before `submit` runs, with the per-field error AND the typed value.

   The model is SHARED, literally the SAME codec value: `type t = Hello_form.t` and `let codec =
   Hello_form.codec` reuse the ONE Sift model that the browser SPA form (web/components/name_form.mlx)
   validates with `Form.signal`. So client and server enforce the SAME [@trim][@non_empty][@max_len 40]
   from one declaration — not two copies that could drift. The ppx-generated `serve` runs `Form.read
   codec`; the <input>'s HTML5 constraints come off the same codec via `Form.input_attrs
   Hello_form.Fields.name` (no hand-written `required`/`maxlength`): browser, client form, and server all
   enforce one source. *)
type t = Hello_form.t = { name : string }

let codec = Hello_form.codec

let view (f : Form.ctx) =
  <main className="page">
    <h1>Say hello</h1>
    {Form.flash f}
    <form method_="post" action="">
      {Form.csrf f}
      <input type_="text" name="name" attrs=(Form.input_attrs Hello_form.Fields.name)
             value=(Form.value f "name") placeholder="Your name" />
      {Form.error f "name"}
      <button type_="submit">Greet</button>
    </form>
  </main>

let submit _conn (t : t) =
  (* a business rule alongside the codec refinements — re-render with an error, keeping the user's input *)
  if String.lowercase_ascii t.name = "admin" then again [ ("name", "that name is reserved — pick another") ]
  else redirect "/hello" ~flash:("Hello, " ^ t.name ^ "!")
