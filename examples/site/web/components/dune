; Shared single-file components. Each .mlx colocates its [%%style] block + inline let%test; group them
; into subfolders freely — (include_subdirs unqualified) folds the whole nested tree into ONE library
; with a FLAT module namespace (a file's name is its module, wherever it sits), so you NEVER add a dune
; inside a subfolder. style_extract (../styles) already scans recursively; the client mirror is generated
; into ../../_client/components (route_gen --mirror) — you only ever touch THIS tree.
(include_subdirs unqualified)

(library
 (name site_components)
 (wrapped false)
 (libraries
  fennec.fur
  fennec.fur.html
  fennec.fur.form
  fennec.fur.server
  site_store
  site_methods
  site_styles
  fennec.pulse.live.client
  fennec.accounts.client
  fennec-mongo.bson
  fennec.pulse.sift
  fennec.pulse.sift.mongo
  fennec-hunt.unit)
 ; Each component carries its own inline let%test (render via Fur.to_html, assert on the HTML) right
 ; below the component — the fur ppx expands them (it ships the hunt test rules), and dune generates the
 ; runner. `fennec test` runs them; a release build drops every body to () (prod-lean), and the generated
 ; client mirror adds -fennec-drop-tests so they never reach the jsoo bundle. fennec.fur.server + site_styles
 ; are TEST-ONLY deps here — email_welcome's test renders through Fur_email with the app's Site_styles.
 (inline_tests
  (backend site_test_runner))
 (preprocess
  (pps fennec.fur.ppx))
 (flags
  (:standard -w -a -open Fur)))
