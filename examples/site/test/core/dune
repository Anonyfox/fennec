; The non-web core end to end in the example — the ticket domain (collections/ + workflows/) and the
; dual-compiled web/methods/ — over the ambient in-memory backend under a real Eio switch. Standalone
; Eio exes run via runtest rules (the full flows need the ambient backend, which an inline let%test
; cannot boot).
(executables
 (names test_tickets test_method)
 (modules test_tickets test_method)
 (libraries fennec.pulse.app fennec-mongo.dynamic fennec-mongo.bson site_collections site_workflows
   site_methods site_store eio eio_main eio.unix unix))

; The optimistic-slot bridge is a CLIENT concern, tested without the server facade (no Fennec_pulse_app
; here) so only the recording Coll_writer backend is installed — see test_optimistic.ml.
(executable
 (name test_optimistic)
 (modules test_optimistic)
 (libraries fennec.pulse.live.client fennec.pulse.method fennec.pulse.live site_methods site_store))

(rule
 (alias runtest)
 (deps test_tickets.exe)
 (action
  (run ./test_tickets.exe)))

(rule
 (alias runtest)
 (deps test_method.exe)
 (action
  (run ./test_method.exe)))

(rule
 (alias runtest)
 (deps test_optimistic.exe)
 (action
  (run ./test_optimistic.exe)))
