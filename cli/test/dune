; Unit tests for the fennec_dev library's pure/testable parts. Tests for crash_limiter,
; diagnostics, instance, report, run, artifact, dev_proto, discover, port, server_proc,
; suites, and ui moved inline into their source modules.

(tests
 (names
  test_dune_watch
  test_pidfile
  test_assets
  test_tty
  test_pool
  test_reaper
  test_mongo_rs)
 (modules
  test_dune_watch
  test_pidfile
  test_assets
  test_tty
  test_pool
  test_reaper
  test_mongo_rs)
 (libraries fennec_dev fennec_tty fennec-paw fennec_testcmd unix))

; The PRIMARY proof for the warm test worker: a direct socket drive (no dev server). It spawns the
; worker and runs the example's COMPONENT inline-test chain + the wwfix reload fixtures, asserting the
; component tests run scoped + at low ms, a cross-file chain, changed-module reload across one worker,
; and the kill→fallback path. Its own executable (it takes %{workspace_root} as an arg and needs
; explicit artifact deps), driven by the rule below so `dune runtest` exercises it.
(executable
 (name test_warm_worker)
 (modules test_warm_worker)
 (libraries fennec_dev unix))

; The transparent transaction over REAL replica-set Mongo (the libmongoc client-session path). Its own
; executable — NOT in the runtest alias — because it spins up a managed mongod (slow, and opt-in like the
; other --mongo paths); it SKIPS cleanly when no mongod is installed. Run it directly to verify the
; native-rollback path: `dune exec cli/test/test_mongo_txn.exe`.
(executable
 (name test_mongo_txn)
 (modules test_mongo_txn)
 (libraries fennec_dev fennec-mongo.dynamic fennec-mongo.bson fennec-mongo.backend eio_main eio unix))

(rule
 (alias runtest)
 (deps
  ; the worker binary the client spawns
  %{project_root}/cli/dev/worker/fennec_test_worker.bc
  ; the example's app libs (the Dynlinked chain): site_components + its app-local deps, byte .cma's
  %{project_root}/examples/site/web/store/site_store.cma
  %{project_root}/examples/site/_client/styles/site_styles.cma
  %{project_root}/examples/site/web/components/site_components.cma
  ; the site_components inline-test runner (its mtime drives the integrated edit) + its generated
  ; byte .cmo (the chain tail — loading it runs the registrations site_components.cma carries)
  %{project_root}/examples/site/web/components/.site_components.inline-tests/inline-test-runner.exe
  %{project_root}/examples/site/web/components/.site_components.inline-tests/.t.eobjs/byte/dune__exe__Main.cmo
  ; the reload + cross-file fixtures
  wwfix/dep/wwfix_dep.cma
  wwfix/v1/wwfix_v1.cma
  wwfix/v2/wwfix_v2.cma
  test_warm_worker.exe)
 (action
  (run %{exe:test_warm_worker.exe})))
